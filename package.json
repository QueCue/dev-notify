{
  "name": "@quecue/dev-notify",
  "version": "0.2.7-beta.1",
  "description": "跨平台开发任务通知工具，支持 Telegram 与飞书",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QueCue/dev-notify.git"
  },
  "homepage": "https://github.com/QueCue/dev-notify#readme",
  "bugs": {
    "url": "https://github.com/QueCue/dev-notify/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "dev-notify": "dist/cli.js"
  },
  "files": [
    "dist/*.js",
    "README.md",
    "README.en.md",
    "SECURITY.md",
    "SECURITY.en.md",
    "CHANGELOG.md",
    "CHANGELOG.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test-js/*.test.mjs",
    "start": "node dist/cli.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.2",
    "@quecue/notify-core": "^0.1.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
